{
  "manifest_version": 3,
  "name": "Hangul Test",
  "version": "1.0",
  "description": "Test extension",
  "action": {
    "default_icon": {
      "16": "images/hangul.png",
      "48": "images/hangul.png",
      "128": "images/hangul.png"
    },
    "default_title": "Hangul Korean Popup Dictionary"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": [
      "js/jquery-3.3.1.min.js",
      "js/zhuyin.js",
      "content.js"
    ],
    "css": ["css/content.css"],
    "all_frames": true
  }
],
  "web_accessible_resources": [
    {
      "resources": ["css/*", "js/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
